#!/usr/bin/env groovy
// ========================================
// CLIXX KUBERNETES GITOPS PIPELINE
// Industry-Standard CI/CD Pipeline
// ========================================
pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '5'))
        ansiColor('xterm')
    }

    environment {
        PATH                = "${PATH}:${getTerraformPath()}"
        VERSION             = "1.0.${BUILD_NUMBER}"
        TERRAFORM_DIR       = "instances"
        AWS_REGION          = "us-east-1"
        AWS_ACCOUNT_ID      = "924305315126"  // Target account (cross-account via provider.tf)
        ECR_REGISTRY        = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPOSITORY      = "clixx-repository2"
        TF_IN_AUTOMATION    = "true"
        TF_CLI_ARGS         = "-no-color"
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'staging', 'prod'],
            description: 'Target deployment environment'
        )
        choice(
            name: 'ACTION',
            choices: ['plan', 'apply', 'destroy'],
            description: 'Terraform action to perform'
        )
        string(
            name: 'RUNNER',
            defaultValue: 'RCLAYE',
            description: 'User initiating the deployment'
        )
        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Skip validation tests (not recommended for prod)'
        )
        booleanParam(
            name: 'AUTO_APPROVE',
            defaultValue: false,
            description: 'Auto-approve without manual confirmation (prod requires manual)'
        )
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag to deploy (leave empty for latest)'
        )
    }

    stages {
        stage('🔐 Checkout & Validate') {
            steps {
                script {
                    // Enforce manual approval for production
                    if (params.ENVIRONMENT == 'prod' && params.AUTO_APPROVE) {
                        error("Auto-approve is not allowed for production deployments!")
                    }
                    
                    currentBuild.displayName = "#${BUILD_NUMBER} - ${params.ENVIRONMENT} - ${params.ACTION}"
                    currentBuild.description = "Deployed by: ${params.RUNNER}"
                }
                
                checkout scm
                
                sh '''
                    echo "📋 Build Information:"
                    echo "  Environment: ${ENVIRONMENT}"
                    echo "  Action: ${ACTION}"
                    echo "  Runner: ${RUNNER}"
                    echo "  Branch: ${GIT_BRANCH}"
                    echo "  Commit: ${GIT_COMMIT}"
                '''
            }
        }

        stage('🔍 Pre-flight Checks') {
            parallel {
                stage('Terraform Lint') {
                    when {
                        expression { !params.SKIP_TESTS }
                    }
                    steps {
                        dir("${TERRAFORM_DIR}") {
                            sh '''
                                echo "🔍 Running Terraform Format Check..."
                                terraform fmt -check -recursive -diff || {
                                    echo "⚠️ Terraform formatting issues found. Run 'terraform fmt' locally."
                                    exit 1
                                }
                            '''
                        }
                    }
                }
                
                stage('Terraform Validate') {
                    when {
                        expression { !params.SKIP_TESTS }
                    }
                    steps {
                        dir("${TERRAFORM_DIR}") {
                            withCredentials([file(credentialsId: "k8-clixx-${params.ENVIRONMENT}", variable: 'TFVARS_FILE')]) {
                                sh '''
                                    echo "🔍 Initializing Terraform for Validation..."
                                    terraform init -backend=false
                                    
                                    echo "🔍 Running Terraform Validate..."
                                    terraform validate
                                '''
                            }
                        }
                    }
                }
                
                stage('Security Scan') {
                    when {
                        expression { !params.SKIP_TESTS }
                    }
                    steps {
                        dir("${TERRAFORM_DIR}") {
                            sh '''
                                echo "🔒 Running TFSec Security Scan..."
                                if command -v tfsec &> /dev/null; then
                                    tfsec . --soft-fail --format json --out tfsec-report.json || true
                                    tfsec . --soft-fail || true
                                else
                                    echo "⚠️ tfsec not installed, skipping security scan"
                                fi
                            '''
                        }
                    }
                }
                
                stage('Cost Estimation') {
                    when {
                        expression { !params.SKIP_TESTS && params.ACTION != 'destroy' }
                    }
                    steps {
                        dir("${TERRAFORM_DIR}") {
                            sh '''
                                echo "💰 Running Infracost Estimation..."
                                if command -v infracost &> /dev/null; then
                                    infracost breakdown --path . --format json --out-file infracost-report.json || true
                                else
                                    echo "⚠️ infracost not installed, skipping cost estimation"
                                fi
                            '''
                        }
                    }
                }
            }
        }

        stage('🔧 Initialize Infrastructure') {
            steps {
                dir("${TERRAFORM_DIR}") {
                    script {
                        def backendConfig = """
                            -backend-config="bucket=clixx-k8-bucket"
                            -backend-config="key=${params.ENVIRONMENT}/terraform.tfstate"
                            -backend-config="region=${AWS_REGION}"
                        """
                        
                        sh """
                            echo "🔧 Initializing Terraform Backend..."
                            terraform init \\
                                ${backendConfig} \\
                                -migrate-state \\
                                -input=false
                        """
                    }
                }
            }
        }

        stage('📋 Plan Infrastructure') {
            when {
                expression { params.ACTION in ['plan', 'apply'] }
            }
            steps {
                dir("${TERRAFORM_DIR}") {
                    withCredentials([file(credentialsId: 'k8-clixxx', variable: 'TFVARS_FILE')]) {
                        script {
                            def imageTag = params.IMAGE_TAG ?: env.VERSION
                            
                            sh """
                                echo "📋 Creating Terraform Plan..."
                                terraform plan \\
                                    -var-file="\$TFVARS_FILE" \\
                                    -var="ecr_image_tag=${imageTag}" \\
                                    -out=tfplan-${params.ENVIRONMENT} \\
                                    -detailed-exitcode \\
                                    -input=false || PLAN_EXIT=\$?
                                
                                # Store plan as artifact
                                terraform show -json tfplan-${params.ENVIRONMENT} > tfplan-${params.ENVIRONMENT}.json
                                terraform show tfplan-${params.ENVIRONMENT} > tfplan-${params.ENVIRONMENT}.txt
                                
                                echo "📊 Plan Summary:"
                                grep -E "^Plan:|^No changes" tfplan-${params.ENVIRONMENT}.txt || true
                            """
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: "${TERRAFORM_DIR}/tfplan-*.txt,${TERRAFORM_DIR}/tfplan-*.json", allowEmptyArchive: true
                }
            }
        }

        stage('✅ Approval Gate') {
            when {
                allOf {
                    expression { params.ACTION == 'apply' }
                    expression { !params.AUTO_APPROVE || params.ENVIRONMENT == 'prod' }
                }
            }
            steps {
                script {
                    def approvers = params.ENVIRONMENT == 'prod' ? 'devops-leads,platform-team' : 'developers,devops'
                    
                    timeout(time: 30, unit: 'MINUTES') {
                        def approval = input(
                            id: 'ApprovalGate',
                            message: "Deploy to ${params.ENVIRONMENT}?",
                            ok: "Approve Deployment",
                            submitter: approvers,
                            parameters: [
                                booleanParam(
                                    name: 'CONFIRM',
                                    defaultValue: false,
                                    description: "I have reviewed the plan and approve deployment to ${params.ENVIRONMENT}"
                                )
                            ]
                        )
                        
                        if (!approval) {
                            error("Deployment not approved!")
                        }
                    }
                }
            }
        }

        stage('🚀 Deploy Infrastructure') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                dir("${TERRAFORM_DIR}") {
                    sh """
                        echo "🚀 Applying Terraform Plan to ${params.ENVIRONMENT}..."
                        terraform apply \\
                            -input=false \\
                            -auto-approve \\
                            tfplan-${params.ENVIRONMENT}
                    """
                }
            }
            post {
                success {
                    echo "✅ Infrastructure deployed to ${params.ENVIRONMENT}"
                }
                failure {
                    echo "❌ Infrastructure deployment failed for ${params.ENVIRONMENT}"
                }
            }
        }

        stage('🔄 Post-Deploy Validation') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                script {
                    dir("${TERRAFORM_DIR}") {
                        def outputs = [:]
                        
                        outputs.appUrl = sh(script: "terraform output -raw application_url 2>/dev/null || echo 'https://ecs.stack-claye.com'", returnStdout: true).trim()
                        outputs.grafanaUrl = sh(script: "terraform output -raw grafana_url 2>/dev/null || echo 'https://grafana.stack-claye.com'", returnStdout: true).trim()
                        outputs.bastionIp = sh(script: "terraform output -raw bastion_public_ip 2>/dev/null || echo 'N/A'", returnStdout: true).trim()
                        outputs.masterIp = sh(script: "terraform output -raw k8s_master_private_ip 2>/dev/null || echo 'N/A'", returnStdout: true).trim()
                        
                        // Store outputs for later stages
                        env.APP_URL = outputs.appUrl
                        env.GRAFANA_URL = outputs.grafanaUrl
                        env.BASTION_IP = outputs.bastionIp
                        env.MASTER_IP = outputs.masterIp
                        
                        // Export as JSON artifact
                        writeFile file: "deployment-outputs-${params.ENVIRONMENT}.json", text: groovy.json.JsonOutput.toJson(outputs)
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: "${TERRAFORM_DIR}/deployment-outputs-*.json", allowEmptyArchive: true
                }
            }
        }

        stage('🩺 Health Check') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                script {
                    echo "⏳ Waiting for K8s cluster initialization (5 minutes)..."
                    sleep(time: 5, unit: 'MINUTES')
                    
                    retry(3) {
                        sh """
                            echo "🩺 Checking application health..."
                            
                            # Check if URL is accessible (with timeout)
                            HTTP_CODE=\$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 30 ${env.APP_URL} || echo "000")
                            
                            if [ "\$HTTP_CODE" = "200" ] || [ "\$HTTP_CODE" = "301" ] || [ "\$HTTP_CODE" = "302" ]; then
                                echo "✅ Application is responding (HTTP \$HTTP_CODE)"
                            else
                                echo "⚠️ Application returned HTTP \$HTTP_CODE (cluster may still be initializing)"
                            fi
                        """
                    }
                }
            }
        }

        stage('🗑️ Destroy Infrastructure') {
            when {
                expression { params.ACTION == 'destroy' }
            }
            steps {
                script {
                    if (params.ENVIRONMENT == 'prod') {
                        input(
                            id: 'DestroyProdConfirm',
                            message: "⚠️ DANGER: You are about to DESTROY PRODUCTION!\nType 'DESTROY-PROD' to confirm:",
                            parameters: [
                                string(name: 'CONFIRM_TEXT', defaultValue: '', description: 'Type DESTROY-PROD to confirm')
                            ]
                        )
                    } else {
                        input(
                            id: 'DestroyConfirm',
                            message: "⚠️ Are you sure you want to DESTROY ${params.ENVIRONMENT}?",
                            ok: "Yes, Destroy"
                        )
                    }
                }
                
                dir("${TERRAFORM_DIR}") {
                    withCredentials([file(credentialsId: 'k8-clixxx', variable: 'TFVARS_FILE')]) {
                        sh """
                            echo "🗑️ Cleaning up K8s resources..."
                            aws ssm delete-parameter --name '/clixx/k8s-join-command' --region ${AWS_REGION} || true
                            
                            echo "🗑️ Destroying ${params.ENVIRONMENT} infrastructure..."
                            terraform destroy \\
                                -var-file="\$TFVARS_FILE" \\
                                -auto-approve
                        """
                    }
                }
            }
            post {
                success {
                    echo "✅ ${params.ENVIRONMENT} infrastructure destroyed"
                }
                failure {
                    echo "❌ Failed to destroy ${params.ENVIRONMENT} - manual cleanup may be required"
                }
            }
        }

        stage('📊 Deployment Summary') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                script {
                    def summary = """
========================================
🎉 DEPLOYMENT COMPLETE - ${params.ENVIRONMENT.toUpperCase()}
========================================
📦 Version: ${env.VERSION}
🌐 Application: ${env.APP_URL}
📊 Grafana: ${env.GRAFANA_URL} (admin/admin123)
🔑 Bastion: ${env.BASTION_IP}
🖥️  Master: ${env.MASTER_IP}
👤 Deployed by: ${params.RUNNER}
🕐 Timestamp: ${new Date().format("yyyy-MM-dd HH:mm:ss z")}

⏳ K8s cluster is initializing (~15-20 min total)
   Monitor: ssh -J ubuntu@${env.BASTION_IP} ubuntu@${env.MASTER_IP}
   Logs: sudo tail -f /var/log/combined-master-init.log
========================================
                    """
                    echo summary
                    
                    // Write summary to file for artifact
                    writeFile file: "deployment-summary-${params.ENVIRONMENT}.txt", text: summary
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: "deployment-summary-*.txt", allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            cleanWs(
                cleanWhenSuccess: true,
                cleanWhenFailure: false,
                cleanWhenAborted: true,
                deleteDirs: true,
                patterns: [
                    [pattern: '**/.terraform/**', type: 'EXCLUDE'],
                    [pattern: '**/tfplan*', type: 'INCLUDE']
                ]
            )
        }
        
        success {
            echo "✅ Pipeline completed successfully"
        }
        
        failure {
            echo "❌ Pipeline failed"
        }
        
        aborted {
            echo "⏹️ Pipeline was aborted"
        }
    }
}

// ========================================
// HELPER FUNCTIONS
// ========================================

def getTerraformPath() {
    return tool(name: 'terraform-14', type: 'terraform')
}
